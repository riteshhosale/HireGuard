NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/jobguard_ai
GEMINI_API_KEY=your_google_gemini_api_key_here
CORS_ORIGIN=http://localhost:5173,https://job-guardai-musa.vercel.app
SCANNER_MODE=direct
